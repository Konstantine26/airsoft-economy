# Reverse proxy to the "app-edge" LXC's Caddy (port 80, serving the Expo web
# export). Copy to /etc/nginx/sites-available/app.example.com on your
# existing nginx LXC/VM, fill in the real domain + the app-edge LXC's IP,
# then:
#   ln -s /etc/nginx/sites-available/app.example.com /etc/nginx/sites-enabled/
#   certbot --nginx -d app.example.com
#   nginx -t && systemctl reload nginx

server {
    listen 80;
    server_name app.example.com;

    location / {
        proxy_pass http://<app-edge-LXC-ip>:80;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
