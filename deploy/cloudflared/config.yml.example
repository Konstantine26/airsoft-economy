# Copy to /etc/cloudflared/config.yml on the "app-edge" LXC (202) and fill in
# the tunnel id + your real domain. Generated by `cloudflared tunnel create`
# (see deploy/cloudflared/README.md for the full walkthrough).
tunnel: <TUNNEL-ID>
credentials-file: /root/.cloudflared/<TUNNEL-ID>.json

ingress:
  # Mobile app + web build talk to Supabase's Kong gateway through this host.
  - hostname: api.example.com
    service: http://<supabase-LXC-ip>:8000

  # Optional web build (organizers on a laptop) - served by Caddy on this same box.
  - hostname: app.example.com
    service: http://localhost:80

  # NOTE: Supabase Studio (port 3000 on the supabase LXC) is deliberately NOT
  # listed here - it's a full DB admin panel and should stay LAN/VPN-only.

  - service: http_status:404
